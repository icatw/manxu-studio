# Copy to .env.prod and fill before ./scripts/deploy.sh
# Generate secrets once and keep them stable across restarts:
#   openssl rand -hex 32

APP_ENV=production
DOMAIN=studio.example.com

# Public HTTPS origin (must match DOMAIN and the browser URL).
CORS_ORIGINS=https://studio.example.com
FRONTEND_BASE_URL=https://studio.example.com
GITHUB_CALLBACK_URL=https://studio.example.com/api/v1/auth/github/callback

SESSION_COOKIE_SECURE=true
SESSION_TTL_DAYS=30

# Required: >= 32 hex chars. Changing this invalidates stored model API keys.
MODEL_ENCRYPTION_KEY=
# Required: >= 32 characters. Do not reuse the process-local development pepper.
EMAIL_CODE_PEPPER=

# Postgres (compose service). Use a strong password; not exposed on the host.
POSTGRES_PASSWORD=

# Real SMTP (Mailpit is disabled in production).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_STARTTLS=true

EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5

# Optional GitHub OAuth (leave blank to hide the button).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Keep false outside playground.
ALLOW_PRIVATE_MODEL_BASE_URLS=false

# Image files stay on the Docker volume image-data (phase 1; not object storage).
IMAGE_STORAGE_DIR=/app/var/images

QWEN_IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
MODEL_PRESET_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_PRESET_TEXT_MODEL=qwen-plus
MODEL_PRESET_IMAGE_MODEL=qwen-image-3.0-pro
IMAGE_MODEL_ALLOWLIST=qwen-image-3.0-pro,qwen-image-3.0,qwen-image-2.1-pro,qwen-image-2.1-turbo

GENERATION_JOB_TIMEOUT_SECONDS=960
GENERATION_STALE_RUNNING_SECONDS=900
IMAGE_TASK_POLL_INTERVAL_SECONDS=5
IMAGE_TASK_POLL_MAX_ATTEMPTS=120

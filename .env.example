DATABASE_URL=postgresql+asyncpg://manxu:manxu@localhost:55442/manxu_dev
CORS_ORIGINS=http://localhost:5173
POSTGRES_PORT=55442
REDIS_PORT=56379
MAILPIT_PORT=8025
API_PORT=8000
FRONTEND_PORT=5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback
FRONTEND_BASE_URL=http://localhost:5173
SESSION_COOKIE_SECURE=false
SESSION_TTL_DAYS=30
# Generate once with `openssl rand -hex 32`; keep this value stable across restarts.
MODEL_ENCRYPTION_KEY=
IMAGE_STORAGE_DIR=./var/images
QWEN_IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
MODEL_PRESET_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_PRESET_TEXT_MODEL=qwen-plus
MODEL_PRESET_IMAGE_MODEL=qwen-image-3.0
# Comma-separated allowlist served by GET /model-config (validated on save).
IMAGE_MODEL_ALLOWLIST=qwen-image-3.0,qwen-image-3.0-pro,qwen-image-2.1-pro,qwen-image-2.1-turbo
# Generation SLA: stale_running < job_timeout; poll_interval * max_attempts <= job_timeout - 60.
GENERATION_JOB_TIMEOUT_SECONDS=960
GENERATION_STALE_RUNNING_SECONDS=900
IMAGE_TASK_POLL_INTERVAL_SECONDS=5
IMAGE_TASK_POLL_MAX_ATTEMPTS=120
REDIS_URL=redis://localhost:56379/0
EMAIL_CODE_PEPPER=
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@manxu.local
SMTP_STARTTLS=false

# Region/workspace API base for DashScope's asynchronous Qwen Image API.

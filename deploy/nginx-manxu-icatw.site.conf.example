# Example host nginx site for Manxu Studio behind existing edge nginx + acme.sh.
# Copy to /etc/nginx/sites-available/manxu-icatw (or studio-icatw), adjust server_name
# and certificate paths, then enable and reload nginx.
#
# Upstream is the compose frontend published at 127.0.0.1:13080
# (see docker-compose.prod.nginx.yml). Frontend Nginx already proxies /api.

upstream manxu_frontend {
    server 127.0.0.1:13080;
    keepalive 16;
}

server {
    listen 80;
    server_name studio.icatw.site;
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name studio.icatw.site;

    # Match existing acme.sh layout on this host, e.g.:
    #   /home/ubuntu/.acme.sh/studio.icatw.site_ecc/fullchain.cer
    #   /home/ubuntu/.acme.sh/studio.icatw.site_ecc/studio.icatw.site.key
    ssl_certificate     /home/ubuntu/.acme.sh/studio.icatw.site_ecc/fullchain.cer;
    ssl_certificate_key /home/ubuntu/.acme.sh/studio.icatw.site_ecc/studio.icatw.site.key;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    client_max_body_size 50m;

    location / {
        proxy_pass http://manxu_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_read_timeout 3600s;
    }
}
